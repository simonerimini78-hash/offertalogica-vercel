{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/guida-bolletta/Guida-OffertaLogica-bolletta-luce-gas.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/collaboratori",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/collaboratori.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/redazione",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/redazione.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/registrazione-editoriale",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/registrazione-editoriale.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/recupera-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/recupera-password.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/articolo.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/editorial-social-instagram",
      "destination": "https://kzxdamhfmzaxonpkytcf.supabase.co/functions/v1/editorial-social-instagram"
    },
    {
      "source": "/editorial-social-facebook",
      "destination": "https://kzxdamhfmzaxonpkytcf.supabase.co/functions/v1/editorial-social-facebook"
    },
    {
      "source": "/articoli/:slug.html",
      "destination": "/api/health?editorial_slug=:slug"
    },
    {
      "source": "/autori/:slug.html",
      "destination": "/api/health?editorial_author_slug=:slug"
    },
    {
      "source": "/sitemap-informa.xml",
      "destination": "/api/health?editorial_sitemap=1"
    },
    {
      "source": "/collaboratori",
      "destination": "/collaboratori.html"
    },
    {
      "source": "/redazione",
      "destination": "/redazione.html"
    },
    {
      "source": "/registrazione-editoriale",
      "destination": "/registrazione-editoriale.html"
    },
    {
      "source": "/recupera-password",
      "destination": "/recupera-password.html"
    },
    {
      "source": "/api/pv-estimate",
      "destination": "/api/unlock-offers"
    }
  ]
}
