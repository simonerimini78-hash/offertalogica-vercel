{
  "name": "offertalogica-vercel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "start": "vercel dev",
    "lint": "node scripts/check-env.mjs",
    "test": "node --test test/*.test.mjs",
