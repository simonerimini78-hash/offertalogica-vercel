    "test:partner-arera": "node scripts/test-partner-arera.mjs",
    "verify:offers": "node scripts/verify-calcolo-offerte.mjs",
    "audit:offers": "node scripts/audit-offers.mjs",
    "sync:arera": "node scripts/sync-arera-open-data.mjs",
    "shortlist:arera": "node scripts/shortlist-arera-candidates.mjs",
    "promote:arera": "node scripts/promote-arera-offer.mjs"
